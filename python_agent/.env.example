LLM_PROVIDER=dashscope
LLM_NATIVE_FUNCTION_CALLING_ENABLED=true
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# The dashscope provider reuses DASHSCOPE_API_KEY below; do not duplicate the key here.
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_THINKING_ENABLED=false

# Vision is independent from the text provider. Recommended: Alibaba Model Studio Qwen3-VL Plus.
VISION_PROVIDER=remote
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
VISION_API_KEY=your-dashscope-api-key
VISION_MODEL=qwen3-vl-plus
VISION_TIMEOUT_SECONDS=60
VISION_CACHE_TTL_SECONDS=300
VISION_CACHE_MAX_ENTRIES=128
# Optional SQLite cache shared by multiple local Agent processes. It stores only
# model results and content hashes, never image bytes or API keys.
VISION_DISK_CACHE_PATH=.runtime/vision-cache.sqlite3
VISION_AUTO_APPROVE_MIN_CONFIDENCE=0.90
RAG_AUTO_APPROVE_MIN_SCORE=0.65

# Standalone-Agent compatibility gate. Docker Compose instead reads this shared
# switch from the repository-root .env file or the invoking shell.
RAG_LAYERED_RETRIEVAL_ENABLED=false
PGVECTOR_DSN=postgresql://postgres:local-dev-password@localhost:5432/after_sales_rag
# Formal-review execution checkpoints use a separate schema. They only keep
# LangGraph runtime cursors; Java/MySQL remains the review business source.
LANGGRAPH_CHECKPOINT_DSN=postgresql://postgres:local-dev-password@localhost:5432/after_sales_rag
LANGGRAPH_CHECKPOINT_SCHEMA=agent_runtime
# DashScope is required for text-embedding-v3 when layered retrieval is enabled.
DASHSCOPE_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3

# Hosted reranking is fail-closed. Leave provider/key empty to disable external calls.
RERANK_PROVIDER=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=3
RERANK_MAX_RETRIES=1
RERANK_MAX_CANDIDATES=20
RERANK_MAX_CONCURRENCY=4
RERANK_CIRCUIT_FAILURE_THRESHOLD=5
RERANK_CIRCUIT_RECOVERY_SECONDS=30
AGENT_AUTO_REFUND_LIMIT=50
AGENT_INTERNAL_TOKEN=replace-with-a-random-shared-secret
AGENT_MAX_REQUEST_BYTES=2097152
# 10 MiB source file after Base64 encoding, plus 1 MiB for JSON metadata.
KNOWLEDGE_PARSE_MAX_REQUEST_BYTES=15029592
AGENT_RECENT_HISTORY_LIMIT=20
AGENT_CONTEXT_MODE=active
AGENT_CONTEXT_WINDOW_TOKENS=8192
AGENT_CONTEXT_SAFETY_TOKENS=2048
# Keep empty for server-to-server deployments. Set a concrete trusted origin only when a browser must call Agent directly.
AGENT_CORS_ALLOW_ORIGIN=

LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=60
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=5
LLM_TOTAL_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENT_REQUESTS=20
LLM_MAX_QUEUE_WAIT_SECONDS=10
LLM_MAX_CONNECTIONS=50
LLM_MAX_KEEPALIVE_CONNECTIONS=20
LLM_KEEPALIVE_EXPIRY_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=8
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_SECONDS=30

LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MAX_CONCURRENT_REQUESTS=2
OLLAMA_MAX_QUEUE_WAIT_SECONDS=3
OLLAMA_KEEP_ALIVE=30m

MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=10
MAX_DUPLICATE_TOOL_CALLS=2
RAG_MULTI_QUERY_MAX_CANDIDATES=3
FORMAL_REVIEW_AUTO_APPROVE_ENABLED=true
FORMAL_REVIEW_MIN_CONFIDENCE=0.75
RAG_SUFFICIENCY_MIN_CONFIDENCE=0.70
TOOL_EXECUTION_TIMEOUT_SECONDS=10
